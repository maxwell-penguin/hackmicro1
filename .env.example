# Copy this file to .env and fill in your own key. .env is gitignored
# and never committed -- each judge/reviewer running `make advanced`
# or `make baseline` needs their own ANTHROPIC_API_KEY here.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used by the Synthesizer/baseline if the
# default in src/agents/synthesizer.py has been retired or renamed.
# MIGRALOOP_MODEL=claude-sonnet-5
